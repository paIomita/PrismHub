local function getConfigFiles()
    local files = {}
    pcall(function()
        local list = listfiles(ConfigFolder)
        for _, file in ipairs(list) do
            local name = file:match(".+[\\/](.+)%.json$")
            if name then
                table.insert(files, name)
            end
        end
    end)
    return files
end

local ConfigsDropdown = ConfigTab:Dropdown({
    Title = "Saved Configs",
    Values = getConfigFiles(),
    Multi = false,
    Callback = function(val)
        currentConfigName = val
        if ConfigNameInput and ConfigNameInput.Set then
            ConfigNameInput:Set(val)
        end
    end
})

ConfigTab:Space()

local function safeSet(element, value)
    if element and element.Set then
        pcall(function()
            element:Set(value)
        end)
    end
end

local function getStateTable()
    return {
        OrbitRadius = S.Orbit.radius,
        OrbitSpeed = S.Orbit.speed,
        OrbitEnabled = S.OrbitEnabled,
        HoverHeight = S.Hover.height,
        HoverEnabled = S.Hover.enabled,
        FreeCamera = S.FreeCamera,
        RemoveEffects = S.RemoveEffects,
        Anonymous = S.Anonymous,
        DisableAntiCheat = S.DisableAntiCheat,
        AutoDodgeEnabled = S.AutoDodge,
        AntiAfkEnabled = S.AntiAfk,
        AutoSkipEnabled = S.AutoSkip,
        AutoRestartEnabled = S.AutoRestart,
        AutoRetreatEnabled = S.AutoRetreat,
        RetreatHealthPercent = S.RetreatHealthPercent,
        AutoPickEnabled = S.AutoPick,
        SelectedMethod = S.SelectedMethod,
        CustomListText = table.concat(S.CustomList, ", "),
        Theme = WindUI:GetCurrentTheme(),
        Acrylic = WindUI.Window.Acrylic,
        Transparent = WindUI:GetTransparency(),
    }
end

local function getMergedStateTable()
    return getStateTable()
end

local function applyStateTable(state)
    S.Loading = true
    task.delay(5, function()
        S.Loading = false
    end)

    local deadline = tick() + 10
    while tick() < deadline do
        if UI.OrbitToggle and UI.MethodDropdown and UI.AutoPickToggle
            and UI.AutoDodgeToggle then
            break
        end
        task.wait(0.1)
    end

    if state.OrbitRadius then safeSet(UI.RadiusSlider, state.OrbitRadius) end
    if state.OrbitSpeed then safeSet(UI.SpeedSlider, state.OrbitSpeed) end
    if state.OrbitEnabled ~= nil then safeSet(UI.OrbitToggle, state.OrbitEnabled) end
    if state.HoverHeight then safeSet(UI.HeightSlider, state.HoverHeight) end
    if state.HoverEnabled ~= nil then safeSet(UI.HoverToggle, state.HoverEnabled) end
    if state.FreeCamera ~= nil then safeSet(UI.FreeCameraToggle, state.FreeCamera) end
    if state.RemoveEffects ~= nil then safeSet(UI.RemoveEffectsToggle, state.RemoveEffects) end
    if state.Anonymous ~= nil then safeSet(UI.AnonymousToggle, state.Anonymous) end
    if state.DisableAntiCheat ~= nil then safeSet(UI.DisableAntiCheatToggle, state.DisableAntiCheat) end
    if state.AntiAfkEnabled ~= nil then safeSet(UI.AntiAfkToggle, state.AntiAfkEnabled) end
    if state.AutoSkipEnabled ~= nil then safeSet(UI.AutoSkipToggle, state.AutoSkipEnabled) end
    if state.AutoRestartEnabled ~= nil then safeSet(UI.AutoRestartToggle, state.AutoRestartEnabled) end
    if state.AutoRetreatEnabled ~= nil then safeSet(UI.AutoRetreatToggle, state.AutoRetreatEnabled) end
    if state.RetreatHealthPercent then safeSet(UI.HealthSlider, state.RetreatHealthPercent) end
    if state.AutoPickEnabled ~= nil then safeSet(UI.AutoPickToggle, state.AutoPickEnabled) end

    if state.SelectedMethod then
        S.SelectedMethod = state.SelectedMethod
        selectDropdown(UI.MethodDropdown, state.SelectedMethod)
    end

    if type(state.CustomListText) == "string" and state.CustomListText ~= "" then
        safeSet(UI.PriorityListInput, state.CustomListText)
    end

    if type(state.Theme) == "string" and state.Theme ~= "" then
        pcall(function()
            WindUI:SetTheme(state.Theme)
        end)
    end
    if type(state.Acrylic) == "boolean" then
        pcall(function()
            if WindUI.Window.Acrylic ~= state.Acrylic then
                WindUI:ToggleAcrylic(state.Acrylic)
            end
        end)
    end
    if type(state.Transparent) == "boolean" then
        pcall(function()
            if Window:GetTransparency() ~= state.Transparent then
                Window:ToggleTransparency(state.Transparent)
            end
        end)
    end

    if state.AutoDodgeEnabled ~= nil then safeSet(UI.AutoDodgeToggle, state.AutoDodgeEnabled) end
end

ConfigTab:Button({
    Title = "Create / Overwrite",
    Color = Green,
    Icon = "",
    Justify = "Center",
    Callback = function()
        if currentConfigName == "" then
            WindUI:Notify({ Title = "Config", Content = "Please enter a name!", Duration = 3 })
            return
        end
        local path = ConfigFolder .. "/" .. currentConfigName .. ".json"
        local fileExists = isfile and isfile(path)
        local json = HttpService:JSONEncode(getMergedStateTable())
        local success, err = pcall(function()
            writefile(path, json)
        end)
        if success then
            ConfigsDropdown:Refresh(getConfigFiles())
            if fileExists then
                WindUI:Notify({ Title = "Config", Content = "Overwrote " .. currentConfigName, Duration = 3 })
            else
                WindUI:Notify({ Title = "Config", Content = "Created " .. currentConfigName, Duration = 3 })
            end
        else
            WindUI:Notify({ Title = "Config", Content = "Save Error: " .. tostring(err), Duration = 5 })
        end
    end,
})

ConfigTab:Space()

ConfigTab:Button({
    Title = "Load Config",
    Color = Blue,
    Icon = "",
    Justify = "Center",
    Callback = function()
        if currentConfigName == "" then
            WindUI:Notify({ Title = "Config", Content = "Please enter or select a name!", Duration = 3 })
            return
        end
        local path = ConfigFolder .. "/" .. currentConfigName .. ".json"
        if not (isfile and isfile(path)) then
            WindUI:Notify({ Title = "Config", Content = "Config file not found!", Duration = 3 })
            return
        end
        local success, err = pcall(function()
            local json = readfile(path)
            local state = HttpService:JSONDecode(json)
            applyStateTable(state)
        end)
        if success then
            WindUI:Notify({ Title = "Config", Content = "Loaded " .. currentConfigName, Duration = 3 })
        else
            WindUI:Notify({ Title = "Config", Content = "Load Error: " .. tostring(err), Duration = 5 })
        end
    end,
})

ConfigTab:Space()

ConfigTab:Button({
    Title = "Delete Config",
    Color = Red,
    Icon = "",
    Justify = "Center",
    Callback = function()
        if currentConfigName == "" then
            WindUI:Notify({ Title = "Config", Content = "Please enter or select a name!", Duration = 3 })
            return
        end
        local path = ConfigFolder .. "/" .. currentConfigName .. ".json"
        if isfile and isfile(path) then
            pcall(function() delfile(path) end)
            ConfigsDropdown:Refresh(getConfigFiles())
            WindUI:Notify({ Title = "Config", Content = "Deleted " .. currentConfigName, Duration = 3 })
        else
            WindUI:Notify({ Title = "Config", Content = "Config not found!", Duration = 3 })
        end
    end,
})

ConfigTab:Space()

ConfigTab:Button({
    Title = "Autoload",
    Color = Purple,
    Icon = "",
    Justify = "Center",
    Callback = function()
        if currentConfigName == "" then
            WindUI:Notify({ Title = "Config", Content = "Please enter or select a config name first!", Duration = 3 })
            return
        end
        local path = ConfigFolder .. "/" .. currentConfigName .. ".json"
        if not (isfile and isfile(path)) then
            WindUI:Notify({ Title = "Config", Content = "Config does not exist! Save it first.", Duration = 4 })
            return
        end
        pcall(function()
            writefile(ConfigFolder .. "/autoload.txt", currentConfigName)
        end)
        WindUI:Notify({ Title = "Config", Content = "'" .. currentConfigName .. "' will AutoLoad on launch!", Duration = 4 })
    end,
})

task.spawn(function()
    task.wait(2)
    local autoloadPath = ConfigFolder .. "/autoload.txt"
    if isfile and isfile(autoloadPath) then
        local successName, configName = pcall(function() return readfile(autoloadPath) end)
        if successName and configName and configName ~= "" then
            local path = ConfigFolder .. "/" .. configName .. ".json"
            if isfile and isfile(path) then
                local successLoad, err = pcall(function()
                    local json = readfile(path)
                    local state = HttpService:JSONDecode(json)
                    applyStateTable(state)
                end)
                if successLoad then
                    WindUI:Notify({ Title = "Config", Content = "AutoLoaded '" .. configName .. "'", Duration = 3 })
                else
                    WindUI:Notify({ Title = "Config", Content = "AutoLoad Error: " .. tostring(err), Duration = 5 })
                end
            else
                WindUI:Notify({ Title = "Config", Content = "AutoLoad config '" .. configName .. "' not found!", Duration = 5 })
            end
        end
    end
end)

ConfigTab:Space()

local currentKey = Enum.KeyCode.LeftControl
local listening = false
local listenConn = nil

local function applyToggleKey(key)
    task.delay(0.1, function()
        pcall(function()
            Window:SetToggleKey(key)
        end)
    end)
end

local function refreshKeybindTitle()
    pcall(function()
        if UI.KeybindButton and UI.KeybindButton.SetTitle then
            UI.KeybindButton:SetTitle("UI Toggle Key: " .. currentKey.Name)
        end
    end)
end

UI.KeybindButton = ConfigTab:Button({
    Title = "UI Toggle Key: " .. currentKey.Name,
    Color = Color3.fromHex("#52525b"),
    Justify = "Center",
    Callback = function()
        if listening then
            if listenConn then
                listenConn:Disconnect()
                listenConn = nil
            end
            listening = false
            applyToggleKey(currentKey)
            return
        end

        listening = true
        pcall(function()
            Window:SetToggleKey(Enum.KeyCode.F24)
        end)
        refreshKeybindTitle()

        listenConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then
                listenConn:Disconnect()
                listenConn = nil
                listening = false
                applyToggleKey(currentKey)
                return
            end
            local key = input.KeyCode
            if key == Enum.KeyCode.Unknown then return end
            listenConn:Disconnect()
            listenConn = nil
            listening = false
            if typeof(key) == "EnumItem" then
                currentKey = key
            end
            refreshKeybindTitle()
            applyToggleKey(currentKey)
        end)
    end,
})

applyToggleKey(currentKey)

