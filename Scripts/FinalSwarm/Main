local ITEM_ALIASES = {
    ["Poison Flask"] = "Poision Flask",
}

local function canonicalItemName(name)
    return ITEM_ALIASES[name] or name
end

local function parseListText(text)
    local list = {}
    for entry in string.gmatch(text or "", "[^,]+") do
        entry = entry:gsub("^%s+", ""):gsub("%s+$", "")
        if entry ~= "" then
            table.insert(list, entry)
        end
    end
    return list
end

