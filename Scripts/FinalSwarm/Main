local platformCurrentY = 0

local function ensureHoverPlatform(rootPart)
    if not S.hoverPlatform or not S.hoverPlatform.Parent then
        for _, child in ipairs(workspace:GetChildren()) do
            if child.Name == "HoverPlatform" then
                child:Destroy()
            end
        end
        clearHoverPlatform()
        S.hoverPlatform = Instance.new("Part")
        S.hoverPlatform.Name = "HoverPlatform"
        S.hoverPlatform.Size = Vector3.new(6, 2, 6)
        S.hoverPlatform.Transparency = 1
        S.hoverPlatform.CanCollide = true
        S.hoverPlatform.CanQuery = false
        S.hoverPlatform.CanTouch = false
        S.hoverPlatform.Anchored = true
        platformCurrentY = rootPart.Position.Y - 3.5
        S.hoverPlatform.CFrame = CFrame.new(rootPart.Position.X, platformCurrentY, rootPart.Position.Z)
        S.hoverPlatform.Parent = workspace
    end
end

local function updateHover()
    if not S.Hover.enabled then return end
    local rootPart = getHumanoidRootPart()
    if not rootPart then return end
    ensureHoverPlatform(rootPart)
    local rayOrigin = rootPart.Position
    local rayDirection = Vector3.new(0, -500, 0)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = { player.Character, S.hoverPlatform }
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    if result then
        local groundY = result.Position.Y
        local targetY = groundY + S.Hover.height
        local distToPlatform = rootPart.Position.Y - platformCurrentY
        if distToPlatform < 3.0 then
            platformCurrentY = rootPart.Position.Y - 3.5
        else
            platformCurrentY = platformCurrentY + (targetY - platformCurrentY) * 0.05
        end
        S.hoverPlatform.CFrame = CFrame.new(rootPart.Position.X, platformCurrentY, rootPart.Position.Z)
    end
end

RunService.Heartbeat:Connect(function()
    updateHover()
end)

