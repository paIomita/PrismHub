    Title = "Anonymous",
    Value = false,
    Callback = function(state)
        S.Anonymous = state
        if state then
            pcall(applyAnonymousAll)
            startAnonFastLoop()
            if not S.Loading then
                WindUI:Notify({ Title = "Visuals", Content = "Anonymous Enabled", Duration = 3 })
            end
        else
            restoreAnonymous()
            if not S.Loading then
                WindUI:Notify({ Title = "Visuals", Content = "Anonymous Disabled", Duration = 3 })
            end
        end
    end,
})

