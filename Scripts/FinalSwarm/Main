local ALLOWED_THEMES = {
    ["Amber"] = true,
    ["CottonCandy"] = true,
    ["Crimson"] = true,
    ["MonokaiPro"] = true,
    ["Dark"] = true
}

local themeNames = {}
for name in pairs(WindUI:GetThemes()) do
    if ALLOWED_THEMES[name] then
        table.insert(themeNames, name)
    end
end
table.sort(themeNames)

