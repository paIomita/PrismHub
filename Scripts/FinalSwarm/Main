    TextSize = 18,
    FontWeight = Enum.FontWeight.SemiBold,
})

MovementTab:Space()

local function getOrbitCenter()
    local spawnPart = nil
    pcall(function()
        spawnPart = workspace:WaitForChild("Map", 10):WaitForChild("SpawnPart", 10)
    end)
    if spawnPart and spawnPart:IsA("BasePart") then
        return spawnPart.Position.X, spawnPart.Position.Z
    end
    return 0, 0
end

local spawnX, spawnZ = getOrbitCenter()
S.Orbit.centerX = spawnX
S.Orbit.centerZ = spawnZ

local function updateOrbit(deltaTime)
    local rootPart = getHumanoidRootPart()
    if not rootPart then return end
    local dt = math.min(deltaTime, 0.1)
    S.Orbit.angle = (S.Orbit.angle + S.Orbit.speed * 6 * dt) % 360
    local currentY = rootPart.Position.Y
    local radAngle = math.rad(S.Orbit.angle)
    local x = S.Orbit.centerX + S.Orbit.radius * math.cos(radAngle)
    local z = S.Orbit.centerZ + S.Orbit.radius * math.sin(radAngle)
    rootPart.CFrame = CFrame.new(x, currentY, z) * CFrame.Angles(0, math.rad(S.Orbit.angle + 90), 0)
end

UI.OrbitToggle = MovementTab:Toggle({
    Title = "Orbit Enabled",
    Value = false,
    Callback = function(state)
        S.OrbitEnabled = state
        if state then
            S.orbitConnection = RunService.RenderStepped:Connect(updateOrbit)
            if not S.Loading then
                WindUI:Notify({ Title = "Movement", Content = "Orbit Enabled", Duration = 3 })
            end
        else
            if S.orbitConnection then
                S.orbitConnection:Disconnect()
                S.orbitConnection = nil
            end
            if not S.Loading then
                WindUI:Notify({ Title = "Movement", Content = "Orbit Disabled", Duration = 3 })
            end
        end
    end,
})

