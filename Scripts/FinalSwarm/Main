local function getHumanoidRootPart()
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart
    end
    return nil
end

local function clearHoverPlatform()
    if S.hoverPlatform then
        S.hoverPlatform:Destroy()
        S.hoverPlatform = nil
    end
end

local function selectDropdown(element, value)
    if not element then return end
    pcall(function()
        if element.Select then
            if type(value) == "table" then
                element:Select(value)
            else
                element:Select({ value })
            end
        elseif element.Set then
            element:Set(value)
        end
    end)
end

local function getGameServiceRemote()
    return ReplicatedStorage
        :WaitForChild("Packages")
        :WaitForChild("_Index")
        :WaitForChild("leifstout_networker@0.3.0")
        :WaitForChild("networker")
        :WaitForChild("_remotes")
        :WaitForChild("GameService")
        :WaitForChild("RemoteEvent")
end

local function getEnemyServiceRemote()
    return ReplicatedStorage
        :WaitForChild("Packages")
        :WaitForChild("_Index")
        :WaitForChild("leifstout_networker@0.3.0")
        :WaitForChild("networker")
        :WaitForChild("_remotes")
        :WaitForChild("EnemyService")
        :WaitForChild("RemoteEvent")
end

local function doRetreat()
    pcall(function()
        local event = getGameServiceRemote()
        if firesignal then
            firesignal(event.OnClientEvent, "RunEnded")
        end
    end)
end

