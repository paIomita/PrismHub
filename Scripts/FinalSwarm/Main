local anticheatDisabledConns = {}
local anticheatOriginalNetworker = nil
local anticheatProxy = nil

local function getAntiCheatService()
    local ok, svc = pcall(function()
        return require(ReplicatedStorage.Shared.Services.AntiCheatService.AntiCheatServiceClient)
    end)
    if ok and type(svc) == "table" then
        return svc
    end
    return nil
end

local function installAnticheatProxy()
    if anticheatProxy then return end
    local svc = getAntiCheatService()
    if not svc then return end
    local real = svc._networker
    if not real then return end
    anticheatOriginalNetworker = real
    local proxy = setmetatable({}, {
        __index = function(_, k)
            return real[k]
        end,
    })
    function proxy:fire(method, ...)
        if method == "ReportViolation" then
            return
        end
        return real:fire(method, ...)
    end
    anticheatProxy = proxy
    svc._networker = proxy
end

local function removeAnticheatProxy()
    if anticheatProxy then
        local svc = getAntiCheatService()
        if svc and anticheatOriginalNetworker then
            svc._networker = anticheatOriginalNetworker
        end
    end
    anticheatProxy = nil
    anticheatOriginalNetworker = nil
end

local function disableAnticheatWatchers()
    pcall(function()
        if not getconnections then return end
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local signals = {
            hum:GetPropertyChangedSignal("WalkSpeed"),
            hum:GetPropertyChangedSignal("JumpHeight"),
            hum:GetPropertyChangedSignal("HipHeight"),
        }
        for _, sig in ipairs(signals) do
            for _, conn in ipairs(getconnections(sig)) do
                if conn.Disable and not table.find(anticheatDisabledConns, conn) then
                    pcall(function() conn:Disable() end)
                    table.insert(anticheatDisabledConns, conn)
                end
            end
        end
    end)
end

local function enableAnticheatWatchers()
    for _, conn in ipairs(anticheatDisabledConns) do
        pcall(function()
            if conn.Enable then conn:Enable() end
        end)
    end
    table.clear(anticheatDisabledConns)
end

player.CharacterAdded:Connect(function()
    if S.DisableAntiCheat then
        task.delay(1.5, function()
            if S.DisableAntiCheat then
                disableAnticheatWatchers()
            end
        end)
    end
end)

UI.DisableAntiCheatToggle = AutofarmTab:Toggle({
    Title = "Disable AntiCheat",
    Value = false,
    Callback = function(state)
        S.DisableAntiCheat = state
        if state then
            installAnticheatProxy()
            disableAnticheatWatchers()
            if not S.Loading then
                WindUI:Notify({ Title = "Autofarm", Content = "Disable AntiCheat Enabled", Duration = 3 })
            end
        else
            removeAnticheatProxy()
            enableAnticheatWatchers()
            if not S.Loading then
                WindUI:Notify({ Title = "Autofarm", Content = "Disable AntiCheat Disabled", Duration = 3 })
            end
        end
    end,
})

