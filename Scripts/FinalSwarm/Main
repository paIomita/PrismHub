local AutoRestartGeneration = 0
local runEndedTime = nil

pcall(function()
    local event = getGameServiceRemote()
    event.OnClientEvent:Connect(function(arg1)
        if arg1 == "RunEnded" then
            runEndedTime = tick()
        end
    end)
end)

UI.AutoRestartToggle = AutofarmTab:Toggle({
    Title = "Auto Restart",
    Value = false,
    Callback = function(state)
        S.AutoRestart = state
        if state then
            AutoRestartGeneration = AutoRestartGeneration + 1
            local myGen = AutoRestartGeneration
            task.spawn(function()
                while S.AutoRestart and myGen == AutoRestartGeneration do
                    if runEndedTime then
                        local elapsed = tick() - runEndedTime
                        local remaining = 5 - elapsed
                        if remaining > 0 then
                            task.wait(remaining)
                        end
                        if not S.AutoRestart or myGen ~= AutoRestartGeneration then
                            break
                        end
                        pcall(function()
                            local event = getGameServiceRemote()
                            event:FireServer("PlayAgain")
                        end)
                        runEndedTime = nil
                    else
                        task.wait(0.5)
                    end
                end
            end)
        end
    end,
})

AutofarmTab:Space()

local AutoRetreatGeneration = 0

UI.AutoRetreatToggle = AutofarmTab:Toggle({
    Title = "Auto Retreat",
    Value = false,
    Callback = function(state)
        S.AutoRetreat = state
        if state then
            AutoRetreatGeneration = AutoRetreatGeneration + 1
            local myGen = AutoRetreatGeneration
            task.spawn(function()
                while S.AutoRetreat and myGen == AutoRetreatGeneration do
                    local char = player.Character
                    if char then
                        local humanoid = char:FindFirstChildOfClass("Humanoid")
                        if humanoid and humanoid.MaxHealth > 0 then
                            local healthPct = (humanoid.Health / humanoid.MaxHealth) * 100
                            if healthPct < S.RetreatHealthPercent then
                                doRetreat()
                            end
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end
    end,
})

