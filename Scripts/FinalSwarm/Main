local function getPriorityList()
    if S.SelectedMethod == "Custom" and #S.CustomList > 0 then
        return S.CustomList
    end
    return DEFAULT_CUSTOM_LIST
end

local lastLevelUpChoices = nil
local lastLevelUpTime = nil

pcall(function()
    local event = getGameServiceRemote()
    event.OnClientEvent:Connect(function(eventName, data)
        if eventName ~= "OnLevelUp" then return end
        if type(data) ~= "table" then return end
        local source = (type(data[1]) == "table") and data[1] or data
        local choices = {}
        for itemName, info in pairs(source) do
            if type(itemName) == "string" and type(info) == "table" and type(info[3]) == "number" then
                choices[itemName] = info[3]
            end
        end
        if next(choices) ~= nil then
            lastLevelUpChoices = choices
            lastLevelUpTime = tick()
        end
    end)
end)

local function isGuiVisible(inst)
    local current = inst
    while current do
        if current:IsA("GuiObject") and current.Visible == false then
            return false
        end
        if current:IsA("ScreenGui") and current.Enabled == false then
            return false
        end
        if current == player then break end
        current = current.Parent
    end
    return true
end

local function getOpenUpgradesHolder()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local frames = playerGui:FindFirstChild("Frames")
    if not frames then return nil end
    local upgrades = frames:FindFirstChild("Upgrades")
    if not upgrades or not isGuiVisible(upgrades) then return nil end
    local holder = upgrades:FindFirstChild("Holder")
    if not holder or not isGuiVisible(holder) then return nil end
    for i = 1, 5 do
        local btn = holder:FindFirstChild("Selection" .. i)
        if btn and isGuiVisible(btn) then
            return holder
        end
    end
    return nil
end

local function readChoicesFromUI(holder)
    local choices = {}
    for i = 1, 5 do
        local btn = holder:FindFirstChild("Selection" .. i)
        if btn and isGuiVisible(btn) then
            local title = btn:FindFirstChild("ItemTitle", true)
            if title and title:IsA("TextLabel") and title.Text ~= "" then
                local text = title.Text:gsub("^%s+", ""):gsub("%s+$", "")
                if text ~= "" then
                    choices[text] = i
                end
            end
        end
    end
    return choices
end

local function pickBestChoice(choices)
    local priority = {}
    local rank = 1
    for _, item in ipairs(getPriorityList()) do
        local canon = canonicalItemName(item)
        if priority[canon] == nil then
            priority[canon] = rank
            rank = rank + 1
        end
    end
    for _, item in ipairs(DEFAULT_CUSTOM_LIST) do
        local canon = canonicalItemName(item)
        if priority[canon] == nil then
            priority[canon] = rank
            rank = rank + 1
        end
    end
    local nextUnknownRank = rank
    local bestRank, bestIndex, bestItem
    for itemName, index in pairs(choices) do
        if type(index) == "number" then
            local canon = canonicalItemName(itemName)
            local r = priority[canon]
            if r == nil then
                r = nextUnknownRank
                nextUnknownRank = nextUnknownRank + 1
            end
            if bestRank == nil or r < bestRank then
                bestRank = r
                bestIndex = index
                bestItem = itemName
            end
        end
    end
    return bestIndex, bestItem
end

local function titleMatches(holder, index, itemName)
    local btn = holder:FindFirstChild("Selection" .. tostring(index))
    if not btn then return false end
    local title = btn:FindFirstChild("ItemTitle", true)
    if not title or not title:IsA("TextLabel") then return false end
    local text = title.Text:gsub("^%s+", ""):gsub("%s+$", "")
    return canonicalItemName(text) == canonicalItemName(itemName)
end

local function clickSelectionButton(btn)
    if not btn then return end
    local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
    end)
    task.delay(0.3, function()
        if btn.Parent and isGuiVisible(btn) and firesignal then
            pcall(function()
                firesignal(btn.MouseButton1Click)
            end)
        end
    end)
end

local pickingBusy = false

local function handleUpgradePick()
    local holder = getOpenUpgradesHolder()
    if not holder then
        pickingBusy = false
        return
    end
    local choices = nil
    local usedEventData = false
    if lastLevelUpChoices and lastLevelUpTime and (tick() - lastLevelUpTime) < 10 then
        choices = lastLevelUpChoices
        usedEventData = true
    end
    lastLevelUpChoices = nil
    lastLevelUpTime = nil
    if type(choices) ~= "table" then
        choices = nil
        usedEventData = false
    end
    if not usedEventData then
        choices = readChoicesFromUI(holder)
    end
    if type(choices) ~= "table" or next(choices) == nil then
        local deadline = tick() + 5
        while tick() < deadline do
            if not getOpenUpgradesHolder() then break end
            task.wait(0.1)
        end
        pickingBusy = false
        return
    end
    local bestIndex, bestItem = pickBestChoice(choices)
    if usedEventData and bestIndex and not titleMatches(holder, bestIndex, bestItem) then
        choices = readChoicesFromUI(holder)
        if type(choices) == "table" and next(choices) ~= nil then
            bestIndex, bestItem = pickBestChoice(choices)
        end
    end
    if bestIndex then
        pcall(function()
            local event = getGameServiceRemote()
            event:FireServer("PlayerUpgradeSelected", bestIndex, 1)
        end)
        WindUI:Notify({ Title = "Auto Pick", Content = "Picked " .. tostring(bestItem), Duration = 3 })
        local btn = holder:FindFirstChild("Selection" .. tostring(bestIndex))
        clickSelectionButton(btn)
    end
    local deadline = tick() + 5
    while tick() < deadline do
        if not getOpenUpgradesHolder() then break end
        task.wait(0.1)
    end
    pickingBusy = false
end

task.spawn(function()
    while true do
        if S.AutoPick and not pickingBusy then
            if getOpenUpgradesHolder() then
                pickingBusy = true
                task.spawn(handleUpgradePick)
            end
        end
        task.wait(0.05)
    end
end)

