ConfigTab:Toggle({
    Title = "Transparent",
    Value = WindUI:GetTransparency(),
    Callback = function(state)
        Window:ToggleTransparency(state)
    end,
})

do
    local tabIcons = {}

    local function findIconHolder(tab)
        local ok, holder = pcall(function()
            local parent = tab.Button and tab.Button.Parent
            if not parent then return nil end
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("Frame") and child:FindFirstChildOfClass("UICorner") then
                    local iconLabel = child:FindFirstChildOfClass("ImageLabel", true)
                        or child:FindFirstChildOfClass("ImageButton")
                    if iconLabel then
                        return child
                    end
                end
            end
            return nil
        end)
        if ok then return holder end
        return nil
    end

    task.delay(1, function()
        local squareRadius = nil
        for _, tab in ipairs(Tabs) do
            local holder = findIconHolder(tab)
            if holder then
                local iconCorner = holder:FindFirstChildOfClass("UICorner")
                if iconCorner then
                    squareRadius = squareRadius or iconCorner.CornerRadius
                    if not tabIcons[tab] then
                        tabIcons[tab] = iconCorner
                    end
                end
            end
        end

        if not squareRadius then
            squareRadius = UDim.new(0, 4)
        end

        local selectedTab = nil
        local function animateShape(tab, radius)
            local corner = tabIcons[tab]
            if not corner then return end
            local tween = TweenService:Create(
                corner,
                TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { CornerRadius = radius }
            )
            tween:Play()
        end

        pcall(function()
            Window:OnTabSelect(function(tab)
                if selectedTab and selectedTab ~= tab then
                    animateShape(selectedTab, squareRadius)
                end
                if tab then
                    animateShape(tab, UDim.new(1, 0))
                end
                selectedTab = tab
            end)
        end)

        task.delay(0.5, function()
            pcall(function()
                Window:SelectTab(1)
            end)
        end)
    end)
end

