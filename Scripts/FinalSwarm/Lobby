local function getAchievementNames()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return FALLBACK_ACHIEVEMENTS end

    local ok, scroll = pcall(function()
        return playerGui
            :WaitForChild("Frames", 3)
            :WaitForChild("Quests", 3)
            :WaitForChild("ScrollFrameCanvas", 3)
            :WaitForChild("PassesScroll", 3)
    end)

    if not ok or not scroll then
        return FALLBACK_ACHIEVEMENTS
    end

    local excluded = {
        AchievementTemplate = true,
        AchievementsTitle   = true,
        QuestTemplateRed    = true,
    }

    local prefix = "Achievement_"
    local names = {}
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") and not excluded[child.Name] then
            local name = child.Name
            if name:sub(1, #prefix) == prefix then
                name = name:sub(#prefix + 1)
            end
            if name ~= "" then
                table.insert(names, name)
            end
        end
    end

    if #names == 0 then
        return FALLBACK_ACHIEVEMENTS
    end
    return names
end

