local function getAllCodes()
    local codes = {}
    local seen = {}
    pcall(function()
        local codeRewards = require(ReplicatedStorage.Shared.Services.CodesService.Modules.CodeRewards)
        if type(codeRewards) == "table" then
            for key, _ in pairs(codeRewards) do
                if type(key) == "string" and not seen[key:lower()] then
                    seen[key:lower()] = true
                    table.insert(codes, key)
                end
            end
        end
    end)
    local knownCodes = {
        "VoidExtension", "Release", "Launch", "Update", "Sorry",
        "FreeKeys", "FreeChests", "Thanks", "Welcome", "Sub",
        "Group", "Discord", "Twitter",
    }
    for _, code in ipairs(knownCodes) do
        if not seen[code:lower()] then
            seen[code:lower()] = true
            table.insert(codes, code)
        end
    end
    return codes
end

