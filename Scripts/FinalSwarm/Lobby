local function gradeRotationMatches(lineRotation, targetRotation)
    local diff = math.abs((lineRotation - targetRotation + 180) % 360 - 180)
    return diff <= GRADE_TOLERANCE
end

local function clickScreenCenter()
    pcall(function()
        local camera = workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        local x = viewport.X / 2
        local y = viewport.Y / 2
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end

local function resolveGradeUI()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local frames = playerGui:FindFirstChild("Frames")
    if not frames then return nil end
    local inv = frames:FindFirstChild("MainInventory")
    if not inv then return nil end
    local grading = inv:FindFirstChild("ArmorGradingSkillFrame")
    if not grading then return nil end
    local skillTest = grading:FindFirstChild("SkillTest")
    if not skillTest then return nil end
    local line = skillTest:FindFirstChild("selectionLine")
    if not line then return nil end
    local area = skillTest:FindFirstChild("SelectionArea")
    if not area then return nil end
    return {
        grading = grading,
        skillTest = skillTest,
        line = line,
        areas = {
            area:FindFirstChild("Large"),
            area:FindFirstChild("Medium"),
            area:FindFirstChild("Small"),
        },
    }
end

local function runGradeSession()
    if gradeSessionActive then return end
    gradeSessionActive = true

    task.spawn(function()
        local sessionStart = tick()
        local sawActive = false
        local hiddenSince = nil
        local lastClick = 0

        while S.AutoGrade do
            local ui = resolveGradeUI()
            local active = ui ~= nil
                and ui.grading.Visible ~= false
                and ui.skillTest.Visible ~= false
                and ui.line.Visible ~= false

            if active then
                sawActive = true
                hiddenSince = nil

                local lineRotation = ui.line.Rotation
                for _, area in ipairs(ui.areas) do
                    if area and area.Visible and gradeRotationMatches(lineRotation, area.Rotation) then
                        if tick() - lastClick >= 0.25 then
                            clickScreenCenter()
                            lastClick = tick()
                        end
                        break
                    end
                end
            else
                if not sawActive then
                    if tick() - sessionStart > 10 then break end
                else
                    if hiddenSince == nil then
                        hiddenSince = tick()
                    elseif tick() - hiddenSince > 1 then
                        break
                    end
                end
            end

            RunService.Heartbeat:Wait()
        end

        gradeSessionActive = false
    end)
end

local function installGradeHook()
    if gradeHookInstalled then return true end
    if not hookmetamethod or not getnamecallmethod then
        return false
    end

    local oldNamecall
    local hookFn = function(self, ...)
        if S.AutoGrade and getnamecallmethod() == "InvokeServer" then
            local args = { ... }
            if type(args[1]) == "string" and args[1] == "startGrading" then
                local isGradeRemote = (gradeRemote ~= nil and self == gradeRemote)
                    or (self.Name == "RemoteFunction" and self.Parent ~= nil and self.Parent.Name == "InventoryService")
                if isGradeRemote then
                    task.defer(runGradeSession)
                end
            end
        end
        return oldNamecall(self, ...)
    end

    if newcclosure then
        hookFn = newcclosure(hookFn)
    end

    oldNamecall = hookmetamethod(game, "__namecall", hookFn)
    gradeHookInstalled = true
    return true
end

local function getDisplayName(modelName)
    if modelName == "WoodenChest" then return "Common" end
    if modelName == "GoldenChest" then return "Premium" end
    return (modelName:gsub("Chest$", ""))
end

local displayValues = {}
local displayToActual = {}
local defaultDisplay = nil
local defaultActual = nil
local discoveredChests = {}

pcall(function()
    local assets = ReplicatedStorage:WaitForChild("Assets", 5)
    if not assets then return end
    local chests = assets:WaitForChild("Chests", 5)
    if not chests then return end
    for _, model in ipairs(chests:GetChildren()) do
        if model:IsA("Model") then
            local keyPos = model:FindFirstChild("KeyPosition", true)
            if keyPos and keyPos:IsA("Attachment") then
                local display = getDisplayName(model.Name)
                if display and not displayToActual[display] then
                    displayToActual[display] = model.Name
                    table.insert(discoveredChests, { display = display, actual = model.Name })
                end
            end
        end
    end
end)

if #discoveredChests == 0 then
    local defaults = {
        { display = "Common",  actual = "WoodenChest"  },
        { display = "Rare",    actual = "RareChest"    },
        { display = "Epic",    actual = "EpicChest"    },
        { display = "Premium", actual = "GoldenChest"  },
    }
    for _, entry in ipairs(defaults) do
        if not displayToActual[entry.display] then
            displayToActual[entry.display] = entry.actual
            table.insert(discoveredChests, entry)
        end
    end
end

local orderPriority = { Common = 1, Rare = 2, Epic = 3, Premium = 4, Void = 5 }
table.sort(discoveredChests, function(a, b)
    local aOrder = orderPriority[a.display] or 999
    local bOrder = orderPriority[b.display] or 999
    if aOrder == bOrder then
        return a.display < b.display
    end
    return aOrder < bOrder
end)

for _, entry in ipairs(discoveredChests) do
    table.insert(displayValues, entry.display)
    if entry.display == "Void" and not defaultDisplay then
        defaultDisplay = entry.display
        defaultActual = entry.actual
    end
end

if not defaultDisplay and #discoveredChests > 0 then
    defaultDisplay = discoveredChests[1].display
    defaultActual = discoveredChests[1].actual
end

if not defaultDisplay then
    defaultDisplay = "Common"
    defaultActual = "WoodenChest"
    if not displayToActual["Common"] then
        displayToActual["Common"] = "WoodenChest"
    end
    if #displayValues == 0 then
        table.insert(displayValues, "Common")
    end
end

S.SelectedDisplay = defaultDisplay
