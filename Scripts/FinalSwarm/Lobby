    while tick() < deadline do
        if UI.ChestDropdown and UI.AutoGradeToggle then
            break
        end
        task.wait(0.1)
    end

    local chestType = state.SelectedChestType or state.SelectedDisplay
    if chestType and displayToActual[chestType] then
        S.SelectedDisplay = chestType
        S.SelectedChest = displayToActual[chestType] or chestType
        selectDropdown(UI.ChestDropdown, chestType)
    end
    if state.PurchaseAmount then
        safeSet(UI.PurchaseAmountInput, tostring(state.PurchaseAmount))
    end
    if state.OpenAmount then
        safeSet(UI.OpenAmountInput, tostring(state.OpenAmount))
    end
    if state.AutoOpenAll ~= nil then safeSet(UI.AutoOpenAllToggle, state.AutoOpenAll) end
    if state.AutoDailyEnabled ~= nil then safeSet(UI.AutoDailyToggle, state.AutoDailyEnabled) end
    if state.AutoAchievementsEnabled ~= nil then safeSet(UI.AutoAchievementsToggle, state.AutoAchievementsEnabled) end
    if state.ClaimDailyKeys ~= nil then safeSet(UI.ClaimDailyKeysToggle, state.ClaimDailyKeys) end
    if state.BuyDailyItems ~= nil then safeSet(UI.BuyDailyItemsToggle, state.BuyDailyItems) end
    if state.AutoCodes ~= nil then safeSet(UI.AutoCodesToggle, state.AutoCodes) end
    if state.AutoGrade ~= nil then safeSet(UI.AutoGradeToggle, state.AutoGrade) end
end

