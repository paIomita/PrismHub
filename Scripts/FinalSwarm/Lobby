local FALLBACK_ACHIEVEMENTS = {
    "ach_bosses", "ach_chests_opened", "ach_daily_logins", "ach_final_swarm",
    "ach_keys_earned", "ach_playtime", "ach_quests_complete", "ach_total_kills",
