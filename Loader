local REPO = "paIomita/PrismHub"
local BRANCH = "main"
local EXT = ""

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local BASE = ("https://raw.githubusercontent.com/%s/%s/"):format(REPO, BRANCH)

local PLACE = {
    Lobby = 99521272836282,
    Main = 79787558257549,
}

local GAMES = {
    [PLACE.Lobby] = "FinalSwarm",
    [PLACE.Main] = "FinalSwarm",
}

local function notify(title, text, duration)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 5,
        })
    end)
end

local function isRaidMode()
    local deadline = tick() + 10
    while tick() < deadline do
        local ok, label = pcall(function()
            return LocalPlayer.PlayerGui.Frames.StartFrame.WorldLabel
        end)
        if ok and label and label:IsA("TextLabel") then
            local text = label.Text or ""
            if text ~= "" then
                return text:upper():find("RAID", 1, true) ~= nil
            end
        end
        task.wait(0.25)
    end
    return false
end

local function runFile(gameName, variant)
    local url = BASE .. "Scripts/" .. gameName .. "/" .. variant .. EXT
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok then
        notify("PrismHub", "Download failed: " .. variant, 8)
        return
    end
    if type(result) == "string" and result:sub(1, 3) == "404" then
        notify("PrismHub", variant .. " not found in repo (404)", 8)
        return
    end
    local fn, err = loadstring(result, "=" .. variant)
    if not fn then
        notify("PrismHub", "Compile error in " .. variant .. ": " .. tostring(err), 8)
        return
    end
    notify("PrismHub", "Loading " .. gameName .. " - " .. variant, 4)
    local ran, runErr = pcall(fn)
    if not ran then
        notify("PrismHub", "Error in " .. variant .. ": " .. tostring(runErr), 8)
    end
end

local gameName = GAMES[game.PlaceId]

if not gameName then
    notify("PrismHub", "This game is not supported.", 6)
else
    local variant
    if game.PlaceId == PLACE.Lobby then
        variant = "Lobby"
    else
        variant = isRaidMode() and "Raid" or "Main"
    end
    runFile(gameName, variant)
end
