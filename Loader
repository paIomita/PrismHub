local REPO = "paIomita"
local BRANCH = "main"
local EXT = ""

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local BASE = ("https://raw.githubusercontent.com/%s/%s/"):format(REPO, BRANCH)

local PLACE = {
    Lobby = 99521272836282,
    Main = 79787558257549,
}

local GAMES = {
    [PLACE.Lobby] = "FinalSwarm",
    [PLACE.Main] = "FinalSwarm",
}

local function isRaidMode()
    local deadline = tick() + 10
    while tick() < deadline do
        local ok, label = pcall(function()
            return LocalPlayer.PlayerGui.Frames.StartFrame.WorldLabel
        end)
        if ok and label and label:IsA("TextLabel") then
            local text = label.Text or ""
            if text ~= "" then
                return text:upper():find("RAID", 1, true) ~= nil
            end
        end
        task.wait(0.25)
    end
    return false
end

local function runFile(gameName, variant)
    local url = BASE .. "Scripts/" .. gameName .. "/" .. variant .. EXT
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok then return end
    if type(result) == "string" and result:sub(1, 3) == "404" then
        return
    end
    local fn = loadstring(result, "=" .. variant)
    if not fn then return end
    pcall(fn)
end

local gameName = GAMES[game.PlaceId]

if gameName then
    local variant
    if game.PlaceId == PLACE.Lobby then
        variant = "Lobby"
    else
        variant = isRaidMode() and "Raid" or "Main"
    end
    runFile(gameName, variant)
end
